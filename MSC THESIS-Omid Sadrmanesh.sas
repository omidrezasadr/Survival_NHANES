IF CARROTS >= 100 THEN CARROTS = .;
IF BROCCOLI >= 60 THEN BROCCOLI = .;
IF BRUSSEL_CAULIFLOWER >= 50 THEN BRUSSEL_CAULIFLOWER = .;
IF POTATO >= 150 THEN POTATO = .;
IF YAMS >= 60 THEN YAMS = .;
IF TOMATO >= 160 THEN TOMATO = .;
IF GREENVEG >= 70 THEN GREENVEG = .;
IF SALAD >= 90 THEN SALAD = .;
IF CABBAGE >= 35 THEN CABBAGE = .;
IF CHILIPEPPER >= 125 THEN CHILIPEPPER = .;
IF OTHERPEPPER >= 100 THEN OTHERPEPPER = .;
IF OTHERVEG >= 150 THEN OTHERVEG = . ;

FRUIT = SUM(CITRUS, MELON, PEACH_NECTARINE, OTHERFRUIT);
VEG = SUM(CARROTS, BROCCOLI, BRUSSEL_CAULIFLOWER , TOMATO, GREENVEG, SALAD, CABBAGE, CHILIPEPPER, OTHERPEPPER, OTHERVEG);
FRUITVEG = FRUIT + VEG;
IF CITRUS = . AND MELON= . AND  PEACH_NECTARINE = . AND  OTHERFRUIT = . AND CARROTS= . AND  BROCCOLI = . AND BRUSSEL_CAULIFLOWER= . AND TOMATO= . AND GREENVEG= . AND SALAD = . AND CABBAGE= . AND CHILIPEPPER= . AND OTHERPEPPER= . AND OTHERVEG = . THEN FRUITVEG= . ;
FRUITVEGPERDAY = FRUITVEG/30;
IF FRUITVEG = . THEN FRUITVEGPERDAY = . ;

* total calories;
IF DIETKCAL > 80000 THEN DIETKCAL = . ;

HRCHOL= 0; 
IF CHOL >= 6.2 THEN HRCHOL= 1;
 if CHOL > 80000 then CHOL = .;
 IF CHOL= . THEN HRCHOL= .;

HRLDL= 0;
IF LDL >= 4.1 THEN HRLDL= 1;
 if LDL > 8000 then LDL = .;
 IF LDL= . THEN HRLDL= .; /*AHA*/

HRTG= 0;
IF TG >= 1.7 THEN HRTG= 1;  * CDC;
 IF TG > 80000 OR PHPFAST < 6 OR PHPFAST > 24 THEN TG = .;
 IF TG= . THEN HRTG= .;

HRHDL= 0;
IF SEX= 1 AND HDL < 1 THEN HRHDL= 1;
 IF SEX= 2 AND HDL < 1.3 THEN HRHDL= 1;
 IF HDL > 8000 OR PHPFAST < 6 OR PHPFAST > 24 THEN HDL = .;
 IF HDL= . THEN HRHDL= .;

if HCDOC >= 8  then HCDOC= . ;
if HCMED >= 8 then HCMED= . ;

DYSLIPID= 0;
IF HRCHOL= 1 OR HRHDL=1 OR HRLDL= 1 OR HRTG= 1 or HCDOC=1 or HCMED=1 THEN DYSLIPID= 1;
 IF HRCHOL= . AND HRHDL= . AND HRLDL= . AND HRTG= . and HCDOC=. and HCMED=. THEN DYSLIPID= 1;

HRBP= 0;
IF DOCHBP= 1 OR HBPMED= 1 OR SBP > 130 OR DBP > 85 THEN HRBP= 1 ;
 IF DOCHBP= . AND HBPMED=. AND SBP=. AND DBP=. THEN HRBP=. ;
IF SBP > 800 THEN SBP = .;
IF DBP > 800 THEN DBP = .;
IF DOCHBP >= 8 THEN DOCHBP= . ;
IF HBPMED >= 8 THEN HBPMED= . ;

IF INSULINPMOL > 800000 OR PHPFAST < 6 OR PHPFAST > 24 THEN INSULINPMOL = . ;
IF INSULINPMOL = 10.56 THEN INSULINPMOL=. ;
HOMA = (INSULINPMOL/6 * GLU) / 22.5;
HRHOMA= 0;
IF HOMA >= 2.5 THEN HRHOMA= 1;
IF HOMA= . THEN HRHOMA= .;

IF BMI > 8000 THEN BMI = . ;

RUN;


