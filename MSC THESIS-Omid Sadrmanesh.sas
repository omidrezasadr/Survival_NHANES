ACTIVE = 0 ; 
IF JOGFQWEEK >= 3 OR EXFQ_MOD_WEEK >= 5 THEN ACTIVE = 1;
IF JOGFQWEEK = . AND EXFQ_MOD_WEEK = . THEN ACTIVE= . ; * the same thing like smoke happended here! ;

