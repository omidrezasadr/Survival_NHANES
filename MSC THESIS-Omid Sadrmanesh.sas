* EDUCATION;
EDUCATIONCAT= 0 ;
IF EDUCATION > 12 THEN EDUCATIONCAT= 1;
 IF EDUCATION > 80 THEN EDUCATION= . ;
 IF EDUCATION = . THEN EDUCATIONCAT = . ;

* ETHNICITY;
WHITE = 0;
IF ETHNIC = 1 THEN WHITE = 1;
 IF ETHNIC = . THEN WHITE = . ;

* FATTY LIVER; * https://wwwn.cdc.gov/nchs/data/nhanes3/34a/HGUHS.htm ;
FATTYLIVER= 0; * normal, mild fatty liver;
IF FATLIVER= 2 THEN FATTYLIVER= 1; * moderate to severe fatty liver; 
 IF FATLIVER >= 7 THEN FATLIVER=. ;
 IF FATLIVER=. THEN FATTYLIVER= .;


ALCOHOLPERWEEK= ALCOHOLPERDAY*7;
if ALCOHOLPERDAY=. then ALCOHOLPERWEEK= . ;

ALCOHOLCAT= 0 ;
   IF SEX= 1 then do;
if ALCOHOLPERWEEK >=1 and ALCOHOLPERWEEK < 15 then ALCOHOLCAT=1;
if ALCOHOLPERWEEK >= 15 THEN ALCOHOLCAT= 2 ;
   end;

   IF SEX= 2 then do;
if ALCOHOLPERWEEK >= 1 and ALCOHOLPERWEEK < 8 then ALCOHOLCAT=1;
if ALCOHOLPERWEEK >= 8 THEN ALCOHOLCAT = 2;
   end;

IF ALCOHOLPERWEEK = . THEN ALCOHOLPERWEEK = 0; 
IF ALCOHOLPERWEEK > 800 THEN ALCOHOLPERWEEK= . ; 


* Hepatitis;
hepatitis= 0;
if hepb= 1 or hepc= 1 then hepatitis= 1;
 if hepb > 2 then hepb= . ;
 if hepc > 2 then hepc= . ;
 if hepb= . and hepc= . then hepatitis= .;

* NAFLD;
NAFLD= 0;
IF FATTYLIVER= 1 AND hepatitis= 0 AND ALCOHOLCAT NE 2 THEN NAFLD= 1;
IF FATTYLIVER= . THEN NAFLD= . ;

hrhs= 0;
if hs= 4 then hrhs=1;
 if hs= . then hrhs=.;
nash= 0;
IF hrhs= 1 AND hepatitis= 0 AND ALCOHOLCAT NE 2 THEN nash= 1;
 IF hrhs= . THEN nash= . ;

* OBESITY;
obesity= 0;
if bmi >= 30 then obesity= 1;
 IF BMI > 8000 THEN BMI = . ;
 if bmi= . then obesity= .;

* diabetes;
HRGLU= 0 ;
IF GLU >= 7 THEN HRGLU= 1;
 IF GLU > 8000 OR PHPFAST < 6 OR PHPFAST > 24 THEN GLU = .;
 IF GLU=. THEN HRGLU=.;

HRHBA1C= 0;
IF HBA1C >= 6.5 THEN HRHBA1C= 1;
 IF HBA1C > 8000 THEN HBA1C = .;
 IF HBA1C =. THEN HRHBA1C=. ;

GLU2CAT= . ;
IF GLUMIN >= 105 AND GLUMIN <= 135 THEN DO;
    IF GLU2 < 7.8 THEN GLU2CAT= 0 ;
     IF GLU2 >= 7.8 AND GLU2 < 11.1 THEN GLU2CAT= 1;
     IF GLU2 >= 11.1 THEN GLU2CAT= 2;
END;
IF GLU2 > 800 THEN GLU2=. ;
IF GLU2= . THEN GLU2CAT= . ;

dm= 0 ;
IF HRGLU= 1  OR HRHBA1C= 1 OR SR_T2DMED= 1 OR  DOCT2D= 1 OR SR_INSULINMED= 1 OR GLU2CAT= 2 THEN dm= 1;
IF HRGLU=. AND HRHBA1C=. AND SR_T2DMED=. AND DOCT2D=. AND SR_INSULINMED=. AND GLU2CAT= . THEN dm=. ;

* CVD;
CVD= 0;
IF DOCHEARTATTACK= 1 OR DOCSTROKE=1 OR DOCCHD=1 THEN CVD=1;
IF DOCHEARTATTACK > 2 THEN DOCHEARTATTACK=. ;
IF DOCSTROKE > 2 THEN DOCSTROKE=. ;
IF DOCCHD > 2 THEN DOCCHD=. ;
 IF DOCHEARTATTACK= . AND DOCSTROKE=. AND DOCCHD=. THEN CVD=.;

